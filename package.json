{
  "name": "@wavehouse/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for WaveHouse — schema-aware real-time API gateway for ClickHouse",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "wavehouse-codegen": "./dist/cli/codegen.js"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run build",
    "codegen": "tsx src/cli/codegen.ts",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "eventsource-parser": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "author": "Wave RF",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wave-RF/wavehouse-sdk-js.git"
  },
  "homepage": "https://wavehouse.dev/sdk",
  "bugs": "https://github.com/Wave-RF/wavehouse-sdk-js/issues",
  "keywords": [
    "wavehouse",
    "clickhouse",
    "real-time",
    "sse",
    "query-builder",
    "typescript"
  ]
}
